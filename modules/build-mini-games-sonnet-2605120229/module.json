{
  "name": "build-mini-games-sonnet-2605120229",
  "description": "Unified mini-games module with daily puzzles (Wordle, Hangman, Hot/Cold) and live chat rounds (Trivia, Scramble, Math race, Reaction race). Skill-based, point-scoring, optional currency rewards, boost tiers, cross-game leaderboards.",
  "version": "latest",
  "supportedGames": [
    "all"
  ],
  "config": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "liveRoundIntervalMinutes": {
        "type": "number",
        "default": 30
      },
      "minPlayersForLiveRound": {
        "type": "number",
        "default": 2
      },
      "liveRoundAnswerWindowSec": {
        "type": "number",
        "default": 60
      },
      "pointsToCurrencyRate": {
        "type": "number",
        "default": 0
      },
      "dailyPointsCapPerPlayer": {
        "type": "number",
        "default": 0
      },
      "bigScoreThreshold": {
        "type": "number",
        "default": 500
      },
      "pointsWordleBase": {
        "type": "number",
        "default": 100
      },
      "pointsHangmanBase": {
        "type": "number",
        "default": 80
      },
      "pointsHotColdBase": {
        "type": "number",
        "default": 60
      },
      "pointsTriviaWin": {
        "type": "number",
        "default": 40
      },
      "pointsScrambleWin": {
        "type": "number",
        "default": 40
      },
      "pointsMathRaceWin": {
        "type": "number",
        "default": 40
      },
      "pointsReactionRaceWin": {
        "type": "number",
        "default": 20
      },
      "triviaQuestionSource": {
        "type": "string",
        "enum": [
          "api",
          "custom"
        ],
        "default": "api"
      },
      "triviaApiDifficulty": {
        "type": "string",
        "enum": [
          "any",
          "easy",
          "medium",
          "hard"
        ],
        "default": "any"
      },
      "triviaApiType": {
        "type": "string",
        "enum": [
          "any",
          "multiple",
          "boolean"
        ],
        "default": "any"
      }
    },
    "additionalProperties": false
  },
  "permissions": [
    {
      "permission": "MINIGAMES_PLAY",
      "friendlyName": "Play mini-games",
      "canHaveCount": false,
      "description": "Allowed to play mini-games."
    },
    {
      "permission": "MINIGAMES_BOOST",
      "friendlyName": "Mini-games boost tier",
      "canHaveCount": true,
      "description": "+25% points per count tier (max 4 = 2.0x)."
    },
    {
      "permission": "MINIGAMES_MANAGE",
      "friendlyName": "Manage mini-games",
      "canHaveCount": false,
      "description": "Admin commands for mini-games."
    },
    {
      "permission": "MINIGAMES_BANNED",
      "friendlyName": "Banned from mini-games",
      "canHaveCount": false,
      "description": "Marker for explicit play-ban."
    }
  ],
  "commands": {
    "wordle": {
      "trigger": "wordle",
      "name": "wordle",
      "function": "src/commands/wordle.js",
      "description": "Daily 5-letter Wordle puzzle. No arg = show status; with guess = submit guess.",
      "helpText": "Usage: /wordle [guess]",
      "arguments": [
        {
          "name": "guess",
          "type": "string",
          "helpText": "Your 5-letter guess",
          "position": 0
        }
      ]
    },
    "hangman": {
      "trigger": "hangman",
      "name": "hangman",
      "function": "src/commands/hangman.js",
      "description": "Daily Hangman puzzle. No arg = show board; single letter = guess letter; word = solve attempt.",
      "helpText": "Usage: /hangman [letter or word]",
      "arguments": [
        {
          "name": "letterOrWord",
          "type": "string",
          "helpText": "A letter or full word guess",
          "position": 0
        }
      ]
    },
    "hotcold": {
      "trigger": "hotcold",
      "name": "hotcold",
      "function": "src/commands/hotcold.js",
      "description": "Daily Hot/Cold number puzzle (1-1000, 8 guesses). No arg = show trail; number = guess.",
      "helpText": "Usage: /hotcold [number]",
      "arguments": [
        {
          "name": "number",
          "type": "number",
          "helpText": "Your guess (1-1000)",
          "position": 0
        }
      ]
    },
    "puzzle": {
      "trigger": "puzzle",
      "name": "puzzle",
      "function": "src/commands/puzzle.js",
      "description": "Show status of today's async puzzles (Wordle, Hangman, Hot/Cold).",
      "helpText": "Usage: /puzzle",
      "arguments": []
    },
    "answer": {
      "trigger": "answer",
      "name": "answer",
      "function": "src/commands/answer.js",
      "description": "Submit your answer to the currently active live round (Trivia, Scramble, Math race).",
      "helpText": "Usage: /answer <response>",
      "arguments": [
        {
          "name": "response",
          "type": "string",
          "helpText": "Your answer to the active live round",
          "position": 0
        }
      ]
    },
    "minigames": {
      "trigger": "minigames",
      "name": "minigames",
      "function": "src/commands/minigames.js",
      "description": "Help/overview of all mini-games. Optionally get rules for a specific game.",
      "helpText": "Usage: /minigames [game]",
      "arguments": [
        {
          "name": "game",
          "type": "string",
          "helpText": "Game name for specific rules",
          "position": 0
        }
      ]
    },
    "minigamestats": {
      "trigger": "minigamestats",
      "name": "minigamestats",
      "function": "src/commands/minigamestats.js",
      "description": "View your lifetime stats across all mini-games.",
      "helpText": "Usage: /minigamestats",
      "arguments": []
    },
    "minigamestop": {
      "trigger": "minigamestop",
      "name": "minigamestop",
      "function": "src/commands/minigamestop.js",
      "description": "Leaderboards. Category: points, wordle, hangman, or streak.",
      "helpText": "Usage: /minigamestop <category>",
      "arguments": [
        {
          "name": "category",
          "type": "string",
          "helpText": "points|wordle|hangman|streak",
          "position": 0
        }
      ]
    },
    "minigamesban": {
      "trigger": "minigamesban",
      "name": "minigamesban",
      "function": "src/commands/minigamesban.js",
      "description": "Ban a player from mini-games.",
      "helpText": "Usage: /minigamesban <player> [hours]",
      "arguments": [
        {
          "name": "player",
          "type": "string",
          "helpText": "Player name or ID to ban",
          "position": 0
        },
        {
          "name": "hours",
          "type": "number",
          "helpText": "Duration in hours (omit for permanent)",
          "position": 1
        }
      ]
    },
    "minigamesunban": {
      "trigger": "minigamesunban",
      "name": "minigamesunban",
      "function": "src/commands/minigamesunban.js",
      "description": "Unban a player from mini-games.",
      "helpText": "Usage: /minigamesunban <player>",
      "arguments": [
        {
          "name": "player",
          "type": "string",
          "helpText": "Player name or ID to unban",
          "position": 0
        }
      ]
    },
    "minigamesresetstats": {
      "trigger": "minigamesresetstats",
      "name": "minigamesresetstats",
      "function": "src/commands/minigamesresetstats.js",
      "description": "Reset a player's lifetime mini-games stats.",
      "helpText": "Usage: /minigamesresetstats <player>",
      "arguments": [
        {
          "name": "player",
          "type": "string",
          "helpText": "Player name or ID",
          "position": 0
        }
      ]
    },
    "minigamesskiproundnow": {
      "trigger": "minigamesskiproundnow",
      "name": "minigamesskiproundnow",
      "function": "src/commands/minigamesskiproundnow.js",
      "description": "Cancel the currently active live round.",
      "helpText": "Usage: /minigamesskiproundnow",
      "arguments": []
    },
    "minigamesfirenow": {
      "trigger": "minigamesfirenow",
      "name": "minigamesfirenow",
      "function": "src/commands/minigamesfirenow.js",
      "description": "Fire a live round immediately.",
      "helpText": "Usage: /minigamesfirenow [game]",
      "arguments": [
        {
          "name": "game",
          "type": "string",
          "helpText": "Game to fire (trivia, scramble, mathrace, reactionrace)",
          "position": 0
        }
      ]
    },
    "minigamesreport": {
      "trigger": "minigamesreport",
      "name": "minigamesreport",
      "function": "src/commands/minigamesreport.js",
      "description": "Get a stats report (PM). Optionally specify number of days.",
      "helpText": "Usage: /minigamesreport [days]",
      "arguments": [
        {
          "name": "days",
          "type": "number",
          "helpText": "Days to include (default 7)",
          "position": 0
        }
      ]
    }
  },
  "hooks": {
    "onChatMessage": {
      "name": "onChatMessage",
      "function": "src/hooks/chat-message.js",
      "eventType": "chat-message"
    },
    "onPlayerDisconnect": {
      "name": "onPlayerDisconnect",
      "function": "src/hooks/player-disconnected.js",
      "eventType": "player-disconnected"
    }
  },
  "cronJobs": {
    "rolloverDailyPuzzles": {
      "name": "rolloverDailyPuzzles",
      "function": "src/cronjobs/rolloverDailyPuzzles.js",
      "temporalValue": "0 0 * * *"
    },
    "fireLiveRound": {
      "name": "fireLiveRound",
      "function": "src/cronjobs/fireLiveRound.js",
      "temporalValue": "*/5 * * * *"
    },
    "closeLiveRound": {
      "name": "closeLiveRound",
      "function": "src/cronjobs/closeLiveRound.js",
      "temporalValue": "* * * * *"
    },
    "refreshLeaderboards": {
      "name": "refreshLeaderboards",
      "function": "src/cronjobs/refreshLeaderboards.js",
      "temporalValue": "*/5 * * * *"
    },
    "expireWindows": {
      "name": "expireWindows",
      "function": "src/cronjobs/expireWindows.js",
      "temporalValue": "0 0 * * *"
    },
    "expireBans": {
      "name": "expireBans",
      "function": "src/cronjobs/expireBans.js",
      "temporalValue": "0 * * * *"
    }
  },
  "functions": {}
}