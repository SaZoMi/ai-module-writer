{
  "name": "build-mini-games-sonnet-2605121210",
  "description": "Unified mini-games module with daily puzzles (Wordle, Hangman, Hot/Cold) and live chat rounds (Trivia, Scramble, Math race, Reaction race). Skill-based, point-scoring, optional currency rewards, boost tiers, cross-game leaderboards.",
  "version": "latest",
  "supportedGames": [
    "all"
  ],
  "config": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "liveRoundIntervalMinutes": {
        "type": "number",
        "default": 30,
        "minimum": 5
      },
      "minPlayersForLiveRound": {
        "type": "number",
        "default": 2,
        "minimum": 1
      },
      "liveRoundAnswerWindowSec": {
        "type": "number",
        "default": 60,
        "minimum": 15
      },
      "pointsToCurrencyRate": {
        "type": "number",
        "default": 0
      },
      "dailyPointsCapPerPlayer": {
        "type": "number",
        "default": 0
      },
      "bigScoreThreshold": {
        "type": "number",
        "default": 500
      },
      "pointsWordleBase": {
        "type": "number",
        "default": 100
      },
      "pointsHangmanBase": {
        "type": "number",
        "default": 80
      },
      "pointsHotColdBase": {
        "type": "number",
        "default": 60
      },
      "pointsTriviaWin": {
        "type": "number",
        "default": 40
      },
      "pointsScrambleWin": {
        "type": "number",
        "default": 40
      },
      "pointsMathRaceWin": {
        "type": "number",
        "default": 40
      },
      "pointsReactionRaceWin": {
        "type": "number",
        "default": 20
      },
      "triviaQuestionSource": {
        "type": "string",
        "enum": [
          "api",
          "custom"
        ],
        "default": "api"
      },
      "triviaApiCategory": {
        "type": "string",
        "default": "any"
      },
      "triviaApiDifficulty": {
        "type": "string",
        "enum": [
          "any",
          "easy",
          "medium",
          "hard"
        ],
        "default": "any"
      },
      "triviaApiType": {
        "type": "string",
        "enum": [
          "any",
          "multiple",
          "boolean"
        ],
        "default": "any"
      },
      "enableWordle": {
        "type": "boolean",
        "default": true
      },
      "enableHangman": {
        "type": "boolean",
        "default": true
      },
      "enableHotCold": {
        "type": "boolean",
        "default": true
      },
      "enableTrivia": {
        "type": "boolean",
        "default": true
      },
      "enableScramble": {
        "type": "boolean",
        "default": true
      },
      "enableMathRace": {
        "type": "boolean",
        "default": true
      },
      "enableReactionRace": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "permissions": [
    {
      "permission": "MINIGAMES_PLAY",
      "friendlyName": "Play mini-games",
      "canHaveCount": false,
      "description": "Allowed to play mini-games."
    },
    {
      "permission": "MINIGAMES_BOOST",
      "friendlyName": "Mini-games boost tier",
      "canHaveCount": true,
      "description": "+25% points per count (cap 4 = 2.0x)."
    },
    {
      "permission": "MINIGAMES_MANAGE",
      "friendlyName": "Manage mini-games",
      "canHaveCount": false,
      "description": "Admin commands."
    },
    {
      "permission": "MINIGAMES_BANNED",
      "friendlyName": "Banned from mini-games",
      "canHaveCount": false,
      "description": "Marker for explicit play-ban."
    }
  ],
  "commands": {
    "wordle": {
      "trigger": "wordle",
      "name": "wordle",
      "description": "Daily 5-letter word puzzle. No arg = show status, with guess = submit.",
      "helpText": "Usage: /wordle [guess]",
      "function": "src/commands/wordle.js",
      "arguments": [
        {
          "name": "guess",
          "type": "string",
          "helpText": "Your 5-letter guess",
          "position": 0
        }
      ]
    },
    "hangman": {
      "trigger": "hangman",
      "name": "hangman",
      "description": "Daily hangman puzzle. No arg = show board, letter/word = guess.",
      "helpText": "Usage: /hangman [letter or word]",
      "function": "src/commands/hangman.js",
      "arguments": [
        {
          "name": "letterOrWord",
          "type": "string",
          "helpText": "A letter or word to guess",
          "position": 0
        }
      ]
    },
    "hotcold": {
      "trigger": "hotcold",
      "name": "hotcold",
      "description": "Daily hot/cold number puzzle 1-1000. No arg = show status, number = guess.",
      "helpText": "Usage: /hotcold [number]",
      "function": "src/commands/hotcold.js",
      "arguments": [
        {
          "name": "number",
          "type": "number",
          "helpText": "Your number guess (1-1000)",
          "position": 0
        }
      ]
    },
    "answer": {
      "trigger": "answer",
      "name": "answer",
      "description": "Submit your answer to the active live round.",
      "helpText": "Usage: /answer <your answer>",
      "function": "src/commands/answer.js",
      "arguments": [
        {
          "name": "response",
          "type": "string",
          "helpText": "Your answer to the active live round",
          "position": 0
        }
      ]
    },
    "puzzle": {
      "trigger": "puzzle",
      "name": "puzzle",
      "description": "Shows today's async puzzle status and time until reset.",
      "helpText": "Usage: /puzzle",
      "function": "src/commands/puzzle.js",
      "arguments": []
    },
    "minigames": {
      "trigger": "minigames",
      "name": "minigames",
      "description": "Help and overview for all mini-games.",
      "helpText": "Usage: /minigames [game]",
      "function": "src/commands/minigames.js",
      "arguments": [
        {
          "name": "game",
          "type": "string",
          "helpText": "Optional game name to see its rules",
          "position": 0
        }
      ]
    },
    "minigamestats": {
      "trigger": "minigamestats",
      "name": "minigamestats",
      "description": "View your mini-games statistics.",
      "helpText": "Usage: /minigamestats [player]",
      "function": "src/commands/minigamestats.js",
      "arguments": [
        {
          "name": "player",
          "type": "string",
          "helpText": "Player name to look up (optional)",
          "position": 0
        }
      ]
    },
    "minigamestop": {
      "trigger": "minigamestop",
      "name": "minigamestop",
      "description": "View leaderboards: points, wordle, hangman, or streak.",
      "helpText": "Usage: /minigamestop <category>",
      "function": "src/commands/minigamestop.js",
      "arguments": [
        {
          "name": "category",
          "type": "string",
          "helpText": "points|wordle|hangman|streak",
          "position": 0
        }
      ]
    },
    "minigamesban": {
      "trigger": "minigamesban",
      "name": "minigamesban",
      "description": "Ban a player from mini-games.",
      "helpText": "Usage: /minigamesban <player> [hours]",
      "function": "src/commands/minigamesban.js",
      "arguments": [
        {
          "name": "player",
          "type": "player",
          "helpText": "Player to ban",
          "position": 0
        },
        {
          "name": "hours",
          "type": "number",
          "helpText": "Ban duration in hours (omit for permanent)",
          "position": 1
        }
      ]
    },
    "minigamesunban": {
      "trigger": "minigamesunban",
      "name": "minigamesunban",
      "description": "Remove a mini-games ban from a player.",
      "helpText": "Usage: /minigamesunban <player>",
      "function": "src/commands/minigamesunban.js",
      "arguments": [
        {
          "name": "player",
          "type": "player",
          "helpText": "Player to unban",
          "position": 0
        }
      ]
    },
    "minigamesresetstats": {
      "trigger": "minigamesresetstats",
      "name": "minigamesresetstats",
      "description": "Reset a player's mini-games statistics.",
      "helpText": "Usage: /minigamesresetstats <player>",
      "function": "src/commands/minigamesresetstats.js",
      "arguments": [
        {
          "name": "player",
          "type": "player",
          "helpText": "Player whose stats to reset",
          "position": 0
        }
      ]
    },
    "minigamesskiproundnow": {
      "trigger": "minigamesskiproundnow",
      "name": "minigamesskiproundnow",
      "description": "Cancel the current active live round.",
      "helpText": "Usage: /minigamesskiproundnow",
      "function": "src/commands/minigamesskiproundnow.js",
      "arguments": []
    },
    "minigamesfirenow": {
      "trigger": "minigamesfirenow",
      "name": "minigamesfirenow",
      "description": "Force-fire a live round immediately.",
      "helpText": "Usage: /minigamesfirenow [game]",
      "function": "src/commands/minigamesfirenow.js",
      "arguments": [
        {
          "name": "game",
          "type": "string",
          "helpText": "Optional game: trivia, scramble, mathrace, reactionrace",
          "position": 0
        }
      ]
    },
    "minigamesreport": {
      "trigger": "minigamesreport",
      "name": "minigamesreport",
      "description": "Get an admin report of mini-games activity.",
      "helpText": "Usage: /minigamesreport [days]",
      "function": "src/commands/minigamesreport.js",
      "arguments": [
        {
          "name": "days",
          "type": "number",
          "helpText": "Number of days to report on (default 7)",
          "position": 0
        }
      ]
    }
  },
  "hooks": {
    "onChatMessage": {
      "name": "onChatMessage",
      "description": "Reaction race: catches raw chat messages to detect winner.",
      "function": "src/hooks/chat-message.js",
      "eventType": "chat-message"
    },
    "onPlayerDisconnect": {
      "name": "onPlayerDisconnect",
      "description": "Soft cleanup on player disconnect; sessions persist.",
      "function": "src/hooks/player-disconnected.js",
      "eventType": "player-disconnected"
    }
  },
  "cronJobs": {
    "rolloverDailyPuzzles": {
      "name": "rolloverDailyPuzzles",
      "description": "Rolls over daily puzzles at UTC midnight.",
      "function": "src/cronjobs/rolloverDailyPuzzles.js",
      "temporalValue": "0 0 * * *"
    },
    "fireLiveRound": {
      "name": "fireLiveRound",
      "description": "Fires a new live mini-game round if conditions are met.",
      "function": "src/cronjobs/fireLiveRound.js",
      "temporalValue": "*/5 * * * *"
    },
    "closeLiveRound": {
      "name": "closeLiveRound",
      "description": "Closes expired live rounds with no winner.",
      "function": "src/cronjobs/closeLiveRound.js",
      "temporalValue": "* * * * *"
    },
    "refreshLeaderboards": {
      "name": "refreshLeaderboards",
      "description": "Refreshes the leaderboard cache every 5 minutes.",
      "function": "src/cronjobs/refreshLeaderboards.js",
      "temporalValue": "*/5 * * * *"
    },
    "expireWindows": {
      "name": "expireWindows",
      "description": "Deletes daily point window variables from prior days.",
      "function": "src/cronjobs/expireWindows.js",
      "temporalValue": "0 0 * * *"
    },
    "expireBans": {
      "name": "expireBans",
      "description": "Removes expired temporary bans.",
      "function": "src/cronjobs/expireBans.js",
      "temporalValue": "0 * * * *"
    }
  },
  "functions": {}
}